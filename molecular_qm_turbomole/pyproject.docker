# Container-only install manifest (dual-use capability package).
# Host: no pyproject.toml — flat tree under simstack-model for create_*_table.
# Image: Dockerfile copies this to pyproject.toml, then `uv pip install .`
[project]
name = "molecular_qm_turbomole"
version = "0.1.0"
description = "TURBOMOLE capabilities for molecular quantum mechanics within the Simstack framework"
readme = "README.md"
requires-python = ">=3.12"
license = { text = "MIT" }
authors = [
  { name = "Wolfgang Wenzel", email = "wolfgang.wenzel@kit.edu" }
]
dependencies = [
    "molecular_qm_models",
    "simstack",
]

[project.entry-points."simstack.modules"]
molecular_qm_turbomole = "molecular_qm_turbomole"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.wheel]
bypass-selection = true

[tool.hatch.build.targets.wheel.force-include]
"__init__.py" = "molecular_qm_turbomole/__init__.py"
"nodes" = "molecular_qm_turbomole/nodes"
"models" = "molecular_qm_turbomole/models"
"lib" = "molecular_qm_turbomole/lib"
"testing" = "molecular_qm_turbomole/testing"
"tests" = "molecular_qm_turbomole/tests"

[tool.uv.sources]
molecular_qm_models = { git = "https://github.com/simstack/molecular_qm_models.git" }
simstack = { git = "https://github.com/simstack/simstack.git", rev = "celso-simstack" }

[tool.uv]
override-dependencies = [
    "molecular_qm_models @ git+https://github.com/simstack/molecular_qm_models.git",
    "simstack @ git+https://github.com/simstack/simstack.git@celso-simstack",
]
